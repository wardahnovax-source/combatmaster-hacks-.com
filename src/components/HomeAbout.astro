---
import HomeAboutApp from './react/HomeAbout';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<HomeAboutApp client:visible locale={locale} />

<style is:global>
	.home-about {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
		color: var(--ink-muted);
	}

	.home-about__head {
		max-width: 42rem;
		margin-bottom: 1.75rem;
	}

	.home-about__eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--magenta);
	}

	.home-about__head h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--ink);
		line-height: 1.15;
	}

	.home-about__lede {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.65;
	}

	.home-about__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.home-about__card {
		padding: 1rem 1.05rem;
		border: 1px solid var(--line-soft);
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--bg-elevated) 55%, transparent);
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.home-about__card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line-soft));
		background: color-mix(in srgb, var(--magenta) 6%, var(--bg-elevated));
	}

	.home-about__card h3 {
		margin: 0 0 0.4rem;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--magenta-soft);
		letter-spacing: -0.01em;
	}

	.home-about__card p {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.home-about__links {
		padding: 1rem 0 0.25rem;
	}

	.home-about__links-head {
		margin-bottom: 0.75rem;
	}

	.home-about__links-head h3 {
		margin: 0 0 0.2rem;
		font-size: 1rem;
		font-weight: 700;
		color: var(--ink);
	}

	.home-about__links-head p {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.home-about__links ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-about__links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--line-soft);
		border-radius: var(--radius-sm);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		background: color-mix(in srgb, var(--bg-elevated) 40%, transparent);
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.home-about__links a:hover {
		color: var(--magenta-soft);
		border-color: color-mix(in srgb, var(--magenta) 30%, var(--line-soft));
		background: color-mix(in srgb, var(--magenta) 8%, transparent);
	}

	.home-about__arrow {
		width: 0.45rem;
		height: 0.45rem;
		border-top: 1.5px solid currentColor;
		border-right: 1.5px solid currentColor;
		transform: rotate(45deg);
		opacity: 0.55;
		flex-shrink: 0;
	}

	@media (max-width: 900px) {
		.home-about__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.home-about__grid,
		.home-about__links ul {
			grid-template-columns: 1fr;
		}
	}
</style>
